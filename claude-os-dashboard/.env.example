# Copy to .env.local and fill in.  .env.local is git-ignored.

# Anthropic API key for /dream consolidation (Phase 2).
# Leave blank in Phase 0; /dream falls back to the deterministic mock.
# Default model is claude-opus-4-8 (see lib/ai/client.ts).
ANTHROPIC_API_KEY=

# Embeddings provider key (Phase 2). NOT Anthropic — Anthropic has no
# embeddings endpoint. v1 targets OpenAI text-embedding-3-small. Optional
# until FEATURE_MEMORY_EMBEDDINGS is on.
EMBEDDING_API_KEY=

# SQLite database path (persistence not wired yet; reserved location).
DATABASE_URL=file:./data/engram-os.sqlite

# Logging: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# Soft daily spend guard for AI calls (USD). A simple skip check, not a system.
DREAM_DAILY_BUDGET_USD=1

# Feature flags. Parsed strictly: only "true" or "1" enable a flag.
# Phase 0 ships with all OFF; turn on per phase.
FEATURE_REAL_CONNECTORS=false
FEATURE_DREAM_LIVE=false
FEATURE_MEMORY_EMBEDDINGS=false
